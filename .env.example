# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Supabase service key (Settings > API Keys). Either the legacy service_role key
# or the new secret key (sb_secret_...) works. Server-only: bypasses RLS and
# must never reach browser code or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Connect > Session pooler, with your database
# password filled in). Used only by `npm run db:push` on your machine to run
# migrations. The app never reads it; do not set it in Vercel.
SUPABASE_DB_URL=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest (Google's rolling stable alias).
# If that alias's current underlying model is hitting free-tier quota limits
# or high-demand 503s, pin a specific model instead, e.g. gemini-3.5-flash —
# GET https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY
# lists what's available and generateContent-capable for your key right now.
GEMINI_MODEL=gemini-flash-latest

# Optional fallback provider. When Gemini is rate limited, out of quota, or
# unavailable (after its own retries), generation switches to Groq for a few
# minutes instead of failing. Both must be set for the fallback to be used;
# the model has no default on purpose (https://console.groq.com/docs/models).
GROQ_API_KEY=
GROQ_MODEL=

# Optional, defaults to Asia/Karachi. "Today", "this week", and every date
# shown in the dashboard and Error Logs use this timezone. Must be a
# NEXT_PUBLIC_ variable because the browser formats dates too.
NEXT_PUBLIC_OPERATOR_TIMEZONE=Asia/Karachi

# Mailgun API key (Settings > API Keys in the Mailgun dashboard)
MAILGUN_API_KEY=

# The sending domain configured in Mailgun, e.g. mg.yourdomain.com
MAILGUN_DOMAIN=

# Optional — defaults to "Email Outreach <outreach@$MAILGUN_DOMAIN>".
# Only the address portion is used now — the display name is built per-send
# as "<sender name> - <sender title>" (or "<sender name>") from each list's configured sender.
MAILGUN_FROM=

# Optional fallback sender identity — used when a lead list has no
# sender_name/sender_title of its own set. If neither this nor the list's
# own value is set, sending is blocked rather than letting the AI invent a
# sign-off. See SETUP.md.
DEFAULT_SENDER_NAME=
DEFAULT_SENDER_TITLE=

# Optional — use https://api.eu.mailgun.net if your Mailgun domain is EU-region
MAILGUN_BASE_URL=https://api.mailgun.net

# Mailgun's HTTP webhook signing key (Sending > Webhooks in the Mailgun
# dashboard — NOT the same value as MAILGUN_API_KEY). Verifies inbound
# reply/bounce/complaint webhooks are genuinely from Mailgun. See SETUP.md.
MAILGUN_WEBHOOK_SIGNING_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" — set
# the same value as the CRON_SECRET env var in your Vercel project so Vercel
# adds this header automatically. Generate any random string.
CRON_SECRET=

# Single shared login for the whole app (no user accounts). Change these
# from the defaults before deploying anywhere reachable.
AUTH_USERNAME=
AUTH_PASSWORD=

# Random secret used to sign session cookies. Generate with, e.g.,
# `openssl rand -hex 32`. Rotating it logs everyone out.
# The Vercel frontend and the Render backend must use the same value.
AUTH_SECRET=

# Public origin used in unsubscribe links inside sent mail. On the split
# deploy this is the Render backend URL, because that host serves
# /api/unsubscribe. Example: https://emailautomation-backend.onrender.com
APP_URL=http://localhost:3000
